<?xml version="1.0" encoding="utf-8"?>
<!-- SEC-02: HTTPS only. Certificate pinning is done in OkHttp (api.certPins), see core/network. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
