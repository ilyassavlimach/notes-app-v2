<?xml version="1.0" encoding="utf-8"?>
<!-- SEC-04: Android 11 and lower — exclude all app data from backups (data_extraction_rules.xml covers 12+). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
